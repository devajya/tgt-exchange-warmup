                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"side\": \"sell\", \"price\": 101, \"quantity\": 5}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
